#!/usr/bin/env python3
import os, sys, json, subprocess, yaml

BASE = os.path.expanduser("~/b4d")

def load_agents():
    with open(f"{BASE}/agents/registry.yaml") as f:
        return yaml.safe_load(f)["agents"]

def run_tools(tool, payload):
    result = subprocess.run(
        [f"{BASE}/core/tools.py", tool, json.dumps(payload)],
        capture_output=True,
        text=True,
        check=True,
    )
    sys.stdout.write(result.stdout.strip())

def call_llm(model, prompt):
    result = subprocess.run(
        ["python3", f"{BASE}/core/ollama_ask.py", model, prompt],
        capture_output=True,
        text=True,
        check=False,
    )
    return result.stdout.strip()

def main():
    if len(sys.argv) < 3:
        print("usage: agent_runner.py <agent> <prompt>", file=sys.stderr)
        sys.exit(1)

    agent = sys.argv[1]
    prompt = " ".join(sys.argv[2:])

    agents = load_agents()

    # deterministic tools entrypoint (no LLM)
    if agent == "tools":
        tool = sys.argv[2]
        payload = json.loads(" ".join(sys.argv[3:]))
        run_tools(tool, payload)
        return

    if agent not in agents:
        print(f"unknown agent: {agent}", file=sys.stderr)
        sys.exit(1)

    model = agents[agent]["model"]
    out = call_llm(model, prompt)

    # TOOL DISPATCH (hard gate, opt-in only)
    if out.startswith("TOOL ") and agent == "tools":
        _, tool, payload = out.split(" ", 2)
        run_tools(tool, json.loads(payload))
        return

    # normal text output
    sys.stdout.write(out + "\n")

if __name__ == "__main__":
    main()
